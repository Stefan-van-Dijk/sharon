{
  "name": "sharon-app",
  "private": true,
  "version": "0.4.08",
  "type": "module",
  "scripts": {
    "test:pwa": "playwright test",
    "version:app": "node scripts/set-version.mjs",
    "test": "node --test tests/*.test.js",
    "test:integration": "node --experimental-vm-modules --test tests/integration/*.test.mjs",
    "check:source": "node scripts/check-syntax.mjs && node scripts/check-imports.mjs && node scripts/check-version.mjs",
    "build": "node scripts/build-site.mjs",
    "verify": "npm run check:source && npm test && npm run build && npm run test:integration && node scripts/verify-site.mjs",
    "test:boards": "playwright test --config playwright.boards.config.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "fake-indexeddb": "6.2.6",
    "jsdom": "26.1.0"
  },
  "engines": {
    "node": "24.19.0"
  }
}
